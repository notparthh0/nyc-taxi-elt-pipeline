{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakeBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET"
    },
    {
      "Sid": "LakeBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/*"
    },
    {
      "Sid": "AthenaQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetDataCatalog",
        "athena:GetTableMetadata",
        "athena:ListTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:YOUR_REGION:YOUR_ACCOUNT_ID:workgroup/primary",
        "arn:aws:athena:YOUR_REGION:YOUR_ACCOUNT_ID:datacatalog/AwsDataCatalog"
      ]
    },
    {
      "Sid": "GlueCatalogForNycTaxi",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:YOUR_REGION:YOUR_ACCOUNT_ID:catalog",
        "arn:aws:glue:YOUR_REGION:YOUR_ACCOUNT_ID:database/nyc_taxi",
        "arn:aws:glue:YOUR_REGION:YOUR_ACCOUNT_ID:table/nyc_taxi/*"
      ]
    }
  ]
}
