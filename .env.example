# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# AWS
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
S3_STAGING=s3://your-s3-bucket-name/athena-results/

# Project paths
PROJECT_ROOT=/absolute/path/to/nyc-taxi-aws
DBT_BIN=dbt

# Dashboard
MODEL_PATH=/absolute/path/to/nyc-taxi-aws/transform/model/xgboost_demand_model.pkl
METRICS_PATH=/absolute/path/to/nyc-taxi-aws/transform/model/evaluation_metrics.json
