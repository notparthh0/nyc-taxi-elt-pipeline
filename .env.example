# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# AWS
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
S3_STAGING=s3://your-s3-bucket-name/athena-results/

# Project paths
PROJECT_ROOT=/absolute/path/to/nyc-taxi-aws
DBT_BIN=dbt

# Dashboard
MODEL_PATH=/absolute/path/to/nyc-taxi-aws/transform/model/xgboost_demand_model.pkl
METRICS_PATH=/absolute/path/to/nyc-taxi-aws/transform/model/evaluation_metrics.json

# Pipeline (v2). Keep comments on their own lines: the Makefile reads this file.
# local (DuckDB, no AWS) or aws (S3 + Athena)
PIPELINE_TARGET=local
# Python with PySpark/XGBoost, used by Airflow tasks
PIPELINE_PYTHON=python3
S3_LAKE_PREFIX=lake/trips_cleaned
# where dbt writes its Athena tables
S3_DATA_DIR=s3://your-s3-bucket-name/dbt/
MODEL_DIR=/absolute/path/to/nyc-taxi-aws/data/lake/model
# where xgboost_demand_model.py reads the mart: athena | duckdb
DATA_SOURCE=athena
DUCKDB_PATH=/absolute/path/to/nyc-taxi-aws/data/lake/warehouse.duckdb
